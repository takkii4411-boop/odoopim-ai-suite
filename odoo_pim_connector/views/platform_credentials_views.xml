<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_platform_credentials_kanban" model="ir.ui.view">
    <field name="name">platform.credentials.kanban</field>
    <field name="model">platform.credentials</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_dashboard" create="false">
            <field name="is_coming_soon"/>
            <field name="is_active"/>
            <field name="name"/>
            <field name="platform"/>

            <templates>
                <!-- Main Template -->
                <t t-name="card">
                    <div class="oe_kanban_card">
                        <div t-if="record.is_coming_soon.raw_value" class="o_kanban_coming_soon_badge">Coming Soon</div>
                        <!-- This is the modified section -->
                        <t t-if="record.is_active.raw_value and !record.is_coming_soon.raw_value">
                            <div class="o_kanban_active_badge">Active</div>
                        </t>
                        <div class="oe_kanban_global_click o_pim_kanban_card"
                            t-att-class="record.is_coming_soon.raw_value ? 'o_kanban_pim_coming_soon' : ''">
                            <div class="o_kanban_image">
                                <img t-att-src="'/odoo_pim_connector/static/src/img/' + record.platform.raw_value + '.png'" alt="Logo"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted">PIM Connector</div>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>

        </kanban>

    </field>
</record>




    <!-- FORM VIEW - Polished Layout -->
    <record id="view_platform_credentials_form" model="ir.ui.view">
        <field name="name">platform.credentials.form</field>
        <field name="model">platform.credentials</field>
        <field name="arch" type="xml">
            <form string="Platform Configuration" create="false" delete="false">
                <header>
                    <button name="action_deactivate" string="Deactivate to Edit"
                            type="object" class="btn-secondary"
                            invisible="is_active == False"/>
                </header>
                <sheet>
                    <!-- "Coming Soon" Banner -->
                    <div class="alert alert-info text-center" role="alert" invisible="is_coming_soon == False">
                        <h4 class="alert-heading">Coming Soon!</h4>
                        <p>This connector is currently under development.</p>
                    </div>
                    
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_mappings" type="object"
                                class="oe_stat_button" icon="fa-arrows-h">
                            <field name="mapping_count" widget="statinfo" string="Field Mappings"/>
                        </button>
                    </div>

                    
                    <!-- Main Header Block -->
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <h1><field name="name" readonly="1" class="oe_inline"/></h1>
                            <group>
                                <field name="platform" readonly="1"/>
                                <field name="is_coming_soon" invisible="1"/>
                                <field name="is_active" widget="boolean_toggle" readonly="1" invisible="is_coming_soon == True"/>
                            </group>
                        </div>
                        <div>
                            <field name="logo_image" widget="image" class="oe_avatar" style="width: 90px; height: 90px;" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <hr invisible="is_coming_soon == True"/>

                    <!-- Main Settings Area - CORRECTED STRUCTURE -->
                    <div invisible="is_coming_soon == True">
                        <group string="Connection Settings">
                            <group invisible="platform != 'shopware'">
                                <field name="shopware_base_url" readonly="is_active"/>
                                <field name="shopware_username" readonly="is_active"/>
                                <field name="shopware_password" password="True" readonly="is_active"/>
                            </group>
                            <group invisible="platform != 'magento'">
                                <field name="magento_base_url" readonly="is_active"/>
                                <!-- <field name="magento_access_token" password="True" readonly="is_active"/> -->
                                <field name="magento_admin_username" readonly="is_active"/>
                                <field name="magento_admin_password" password="True" readonly="is_active"/>
                            </group>
                             <group invisible="platform != 'shopify'">
                                <field name="shopify_shop_subdomain" readonly="is_active"/>
                                <!-- <field name="magento_access_token" password="True" readonly="is_active"/> -->
                                <field name="shopify_client_id" readonly="is_active"/>
                                <field name="shopify_client_secret" password="True" readonly="is_active"/>
                                <field name="shopify_access_token" password="True" readonly="is_active"/>
                            </group>
                            <group invisible="platform != 'b2b'">
                                <field name="b2b_shop_subdomain" readonly="is_active"/>
                                <field name="b2b_client_id" readonly="is_active"/>
                                <field name="b2b_client_secret" password="True" readonly="is_active"/>
                                <field name="b2b_access_token" password="True" readonly="is_active"/>
                            </group>
                        </group>
                        
                        <group string="Connection Test">
                            <button name="test_connection" type="object" string="Test Connection" class="btn-primary" icon="fa-check"/>
                            <field name="Status" nolabel="1" readonly="1"/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- MENUS AND ACTION -->
    <record id="action_platform_credentials_dashboard" model="ir.actions.act_window">
        <field name="name">PIM Connectors</field>
        <field name="res_model">platform.credentials</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <menuitem id="menu_pim_connector_root" name="Channel PIM Connector" sequence="10" web_icon="odoo_pim_connector,static/description/odoo_n8n_pim.png"/>
    <menuitem id="menu_pim_dashboard" name="Dashboard" parent="menu_pim_connector_root" sequence="1" action="action_platform_credentials_dashboard"/>

</odoo>
