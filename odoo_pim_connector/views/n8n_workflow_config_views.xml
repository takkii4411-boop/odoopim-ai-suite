<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_n8n_workflow_config_list" model="ir.ui.view">
        <field name="name">n8n.workflow.config.list</field>
        <field name="model">n8n.workflow.config</field>
        <field name="arch" type="xml">
            <list string="N8N Workflows">
                <field name="name"/>
                <field name="platform"/>
                <field name="n8n_workflow_id"/>
                <field name="n8n_webhook_url"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_n8n_workflow_config_form" model="ir.ui.view">
        <field name="name">n8n.workflow.config.form</field>
        <field name="model">n8n.workflow.config</field>
        <field name="arch" type="xml">
            <form string="N8N Workflow">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="platform"/>
                        <field name="n8n_workflow_id"/>
                        <field name="n8n_webhook_url"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_n8n_workflow_config" model="ir.actions.act_window">
        <field name="name">N8N Workflows</field>
        <field name="res_model">n8n.workflow.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_n8n_workflow_config"
              name="N8N Workflows"
              parent="menu_pim_configuration"
              action="action_n8n_workflow_config"
              sequence="10"/>
</odoo>
