<?xml version="1.0" encoding="utf-8"?>
<odoo>

 <!-- Sync Log Form View - FINAL PROFESSIONAL LAYOUT -->
    <record id="view_pim_sync_log_form" model="ir.ui.view">
        <field name="name">pim.sync.log.form</field>
        <field name="model">pim.sync.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_check_n8n_status" string="Check Status from channel"
                            type="object" class="btn-secondary"
                            invisible="status not in ('sent', 'processing')"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="name" string="Operation" invisible="1"/>
                            <field name="platform_id"/>
                            <field name="product_count"/>
                        </group>
                        <group>
                            <field name="n8n_execution_id" readonly="1"/>
                            <field name="status" widget="badge"
                                   decoration-info="status in ('queued', 'sent')"
                                   decoration-warning="status in ('processing', 'partial')"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status == 'error'"/>
                        </group>
                    </group>
                    
                    <hr/>
                    
                    <!-- Main Two-Column Summary Area -->
                    <group>
                        <!-- Left Column: Summary and Products -->
                        <group>
                            <div class="oe_grey_box">
                                <h4>Execution Summary</h4>
                                <group>
                                    <field name="summary_message" nolabel="1"/>
                                    <field name="successful_items"/>
                                    <field name="failed_items"/>
                                </group>
                            </div>
                        </group>

                        <!-- Right Column: Products List -->
                        <group string="Products Sent in this Batch">
                             <field name="product_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="default_code" string="SKU"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- Conditional Error Log Section -->
                    <div class="mt-4" invisible="failed_items == 0">
                        <h3>Error Details</h3>
                        <div class="alert alert-danger" role="alert">
                            <field name="error_details_html" nolabel="1"/>
                        </div>
                    </div>

                    <!-- Raw Data hidden in a Notebook for technical users -->
                    <notebook>
                        <page string="Request Payload (Raw)" invisible="1">
                            <field name="request_payload" widget="ace" options="{'mode': 'json'}" readonly="1" invisible="1"/>
                        </page>
                        <page string="n8n Response (Raw)" invisible="1">
                            <field name="response_text" widget="ace" options="{'mode': 'json'}" readonly="1" invisible="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pim_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">pim.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Field Mapping Search View -->
    <record id="view_pim_field_mapping_search" model="ir.ui.view">
        <field name="name">pim.field.mapping.search</field>
        <field name="model">pim.field.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="platform_id"/>
                <filter string="Active Connectors" name="active_connectors"
                        domain="[('platform_id.is_active', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Connector" name="group_by_platform" context="{'group_by': 'platform_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Sync Log List View - UPDATED -->
    <record id="view_pim_sync_log_tree" model="ir.ui.view">
        <field name="name">pim.sync.log.tree</field>
        <field name="model">pim.sync.log</field>
        <field name="arch" type="xml">
            <list create="false">
                <!-- These are the new columns as you requested -->
                <field name="sync_id" string="Sync ID"/>
                <field name="create_date" string="Created Date"/>
                <field name="platform_id" string="Channel"/>
                <field name="status" widget="badge"
                    decoration-info="status in ('queued', 'sent')"
                    decoration-warning="status in ('processing', 'partial')"
                    decoration-success="status == 'success'"
                    decoration-danger="status == 'error'"/>
                <field name="n8n_execution_id" string="Channel Execution ID"/>
            </list>
        </field>
    </record>

    <!-- Field Mapping List View -->
    <record id="view_pim_field_mapping_tree" model="ir.ui.view">
        <field name="name">pim.field.mapping.tree</field>
        <field name="model">pim.field.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="platform_id" options="{'no_create': True}"/>
                <field name="odoo_model_id" invisible="1"/>
                <field name="odoo_field_id" options="{'no_create': True}"/>
                <field name="external_field_key" widget="selection"/>
                <field name="is_required" readonly="1"/>
            </list>
        </field>
    </record>
    
    <record id="view_pim_platform_mapping_list" model="ir.ui.view">
        <field name="name">pim.platform.mapping.list</field>
        <field name="model">pim.platform.mapping</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name" string="Connector Mapping"/>
            </list>
        </field>
    </record>

     <!-- Field Mapping Action -->
    <record id="action_pim_field_mapping" model="ir.actions.act_window">
        <field name="name">Field Mapping</field>
        <field name="res_model">pim.platform.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>