<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="pim_ext.TreeFormView" t-inherit="odoopim_split_widget.TreeFormView" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click.stop='toggleFilter']" position="before">
            <button class="p-2 border rounded d-flex" t-on-click="ClickOpenLanguages">
                 <img t-att-src="'/web/image/res.lang/'+ this.active_lang['id'] +'/flag_image'"
                 style="width: 20px; height:18px; border-radius: 0px;" />
                <span class="ms-2"><t t-esc="this.active_lang['iso_code'].toUpperCase()"/></span>
                <span class="ms-2"><i class="langDropIcon fa fa-angle-down"/></span>
            </button>
            <div class="LanguagesDrop d-none position-absolute border rounded bg-white p-2" style="right:30px;top:116px;z-index:10;width:auto;">
                <input t-if="this.langState.all_langs.length > 7"
                       type="text"
                       t-on-input="(ev) => this.SearchLang(ev.target.value)"
                       class="form-control rounded"
                       placeholder="search..."/>
                <div class="Languages mt-2" style="max-height:300px;overflow-y:scroll;scrollbar-width: none;">
                    <t t-foreach="this.langState.filterLang" t-as="lang" t-key="lang_index">
                        <t t-if="lang.code == this.langState.lang">
                            <a class="d-flex p-1 text-primary mb-1 rounded"
                               style="cursor:pointer;border-bottom:1px solid #efefef;background:#efefef;"
                               t-on-click="() => this.SelectLang(lang.code)">
                                <img t-att-src="'/web/image/res.lang/'+ lang.id +'/flag_image'"
                                     style="width: 20px; height:20px; border-radius: 20px;" />
                                <span class="ms-2"><t t-esc="lang.name"/></span>
                            </a>
                        </t>
                        <t t-else="">
                            <a class="d-flex p-1 text-primary mb-1"
                               style="cursor:pointer;border-bottom:1px solid #efefef;"
                               t-on-click="() => this.SelectLang(lang.code)">
                                <img t-att-src="'/web/image/res.lang/'+ lang.id +'/flag_image'"
                                     style="width: 20px; height:20px; border-radius: 20px;" />
                                <span class="ms-2"><t t-esc="lang.name"/></span>
                            </a>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
