<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pim_ext.ImageDNDField">
        <div class="d-inline-block position-relative opacity-trigger-hover o_field_image o_image_dnd_zone"
             t-att-class="{ 'o_dnd_dragging': state.isDragging }"
             t-on-dragenter="onDragEnter"
             t-on-dragleave="onDragLeave"
             t-on-dragover="onDragOver"
             t-on-drop="onDrop">

           
            <div class="position-relative d-flex justify-content-center align-items-center w-100 h-100">
                <img t-att-src="imageUrl"
                     class="img img-fluid"
                     alt="Product Image"
                     style="object-fit: contain; max-height: 100%; width: 100%;"/>
            </div>

            <div class="o_dnd_overlay" t-if="state.isDragging">
                <div class="text-center" style="color: #71639e;">
                    <i class="fa fa-cloud-upload fa-3x mb-2"></i>
                    <h4>Drop Here</h4>
                </div>
            </div>

            <div class="position-absolute d-flex justify-content-between w-100 bottom-0 opacity-0 opacity-100-hover p-1"
                 t-if="!props.readonly">
                <span class="">
                    <button class="btn btn-light border-0 rounded-circle m-1 p-1"
                            data-tooltip="Edit" 
                            t-on-click="onFileOpen">
                        <i class="fa fa-pencil fa-fw"></i>
                    </button>
                   
                    <button t-if="props.record.data[props.name]"
                            class="btn btn-light border-0 rounded-circle m-1 p-1"
                            data-tooltip="Clear" 
                            t-on-click="onFileRemove">
                        <i class="fa fa-trash fa-fw"></i>
                    </button>
                </span>
                
                <input type="file" 
                       class="d-none"
                       accept="image/*,video/*"
                       t-ref="file_input_dnd" 
                       t-on-change="onFileInputChange"/>
            </div>
        </div>
    </t>
</templates>
