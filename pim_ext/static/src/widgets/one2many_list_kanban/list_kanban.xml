<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pim_ext.multyX2ManyField" t-inherit="web.X2ManyField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_x2m_control_panel')]" position="before">
           <nav t-if="this.is_multi_view" class="o_cp_switch_buttons text-end"
                style="position: relative;height:8vh;">
               <button class="btn btn-secondary o_switch_view o_list"
                       t-attf-class="{{this.MultiState.currentView == 'list' ? 'active' : ''}}"
                       t-on-click="() => this.switchView('list')"
                       data-tooltip="List">
                   <i class="oi oi-view-list"></i>
               </button>
               <button class="btn btn-secondary o_switch_view o_kanban"
                       t-attf-class="{{this.MultiState.currentView == 'kanban' ? 'active' : ''}}"
                       t-on-click="() => this.switchView('kanban')"
                       data-tooltip="Kanban">
                   <i class="oi oi-view-kanban"></i>
               </button>
           </nav>
        </xpath>
        <xpath expr="//ListRenderer" position="attributes">
            <attribute name="t-if">this.MultiState.currentView == 'list'</attribute>
        </xpath>
        <xpath expr="//KanbanRenderer" position="attributes">
            <attribute name="t-elif">this.MultiState.currentView == 'kanban'</attribute>
        </xpath>
    </t>
</templates>