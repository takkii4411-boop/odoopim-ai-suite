<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="family_wizard_form_view" model="ir.ui.view">
        <field name="name">family.wizard.form.view</field>
        <field name="model">family.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="product_ids" widget="many2many_tags" invisible="0"/>
                        <field name="family_id" invisible="0"/>
                    </group>
                </sheet>
                 <footer>
                    <button name="action_update" string="Add Family" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>