<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="category_wizard_form_view" model="ir.ui.view">
        <field name="name">category.wizard.form.view</field>
        <field name="model">category.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="family_ids" widget="many2many_tags" invisible="1"/>
                        <field name="product_ids" widget="many2many_tags" invisible="1"/>
                        <field name="selected_category_id" invisible="1"/>
                        <field name="category_ids" string=" " nolable="1" options="{'no_delete': True}">
                            <list editable="top" create="0" delete="false">
                                <field name="select" string="Select"/>
                                <field name="pim_category_id" string="Category" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
                                <field name="category_id" column_invisible="1" string="Category" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                 <footer>
                    <button name="action_update" string="Add Category" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>