<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoopim_split_widget.ProductHeader" owl="1">
        <!-- Main Content Card -->

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="row">
                    <!-- Product Image -->
                    <div class="col-12 col-lg-4 mb-4 mb-lg-0">
                        <a href="#" t-on-click.prevent="showImagePreview" class="d-block mb-3">
                            <div class="bg-light rounded p-4 text-center">
                        <img t-att-src="primaryImageUrl"
                            t-att-alt="this.props.record.data.name"
                            class="img-fluid"
                            style="max-height: 150px;"/>
                    </div>
                        </a>
                    </div>

                    <!-- Product Details -->
                    <div class="col-12 col-lg-8">
                        <!-- Product Info -->
                        <div class="mb-4">
                            <div class="text-muted small mb-2">Product SKU #<t t-esc="this.props.record.data.sku"/></div>
                            <h2 class="h3 fw-semibold mb-3"><t t-esc="this.state.display_name"/></h2>
                        </div>

                        <div class="row">
                            <div class="col-12 col-md-6">
                                <div class="mb-2">
                                <span class="text-muted small">Brand:</span>
                                <span class="small mx-2"><t t-esc="this.props.record.data.brand_id ? this.props.record.data.brand_id[1]:'N/A'"/></span>
                            </div>
                            <div class="mb-4">
                                <span class="text-muted small">Family:</span>
                                <span class="small mx-2"><t t-esc="this.props.record.data.family_id ? this.props.record.data.family_id[1]:'N/A'"/></span>
                            </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="mb-2">
                                    <span class="text-muted small">Status:</span>
                                    <span class="small mx-2"><t t-esc="this.props.record.data.active_label"/></span>
                                </div>
                                <div class="mb-4">
                                    <span class="text-muted small">Category:</span>
                                    <span class="small mx-2"><t t-esc="this.categories_name"/></span>
                                </div>
                            </div>

                        </div>

                        <!-- Quality and Completeness -->
                        <div class="row">
                            <!-- Quality -->
                            <div class="col-12 col-md-6 mb-4 mb-md-0">
                                <h6 class="text-muted mb-2">Quality:</h6>
                                <div class="quality-section">
                                    <img t-att-src="quality_image_url" alt="Quality" class="quality-badge me-2"/>
                                </div>
                            </div>

                            <!-- Completeness -->
                            <div class="col-12 col-md-4" t-if="!this.props.record.data.has_configurable_attributes">
                                <h6 class="text-muted mb-2">Completeness:</h6>
                                <div class="completeness-section">
                                    <div class="progress mb-2" style="height: 12px;">
                                        <div class="progress-bar-custom"
                                             t-att-class="getBgClass"
                                             role="progressbar"
                                             t-att-style="'width:' + progressWidth"></div>
                                    </div>
                                    <div class="d-flex justify-content-between small">
                                        <span class="text-muted"><t t-esc="displayValue"/> completed</span>
                                        <span class="text-muted">100%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
