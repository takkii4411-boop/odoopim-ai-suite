<!--                        </div>-->
<!--                        <t t-set="count" t-value="count + 1"/>-->
<!--                    </t>-->
                </div>
            </div>

            <!--NAVIGATION BUTTONS-->
            <div class="d-flex justify-content-between">
                <button class="btn btn-outline-secondary px-5"
                        t-att-disabled="this.state.step === 0"
                        t-on-click="() => this.nextStep(-1)">
                    Previous
                </button>
                <button class="btn btn-primary px-5" style="transition:0.5s;"
                        t-if="this.state.step != 2"
                        t-on-click="() => this.nextStep(1)">
                    <t t-esc="this.state.button_name"/>
                </button>
            </div>
        </div>
    </t>
</templates>
