<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_platform_credentials_create_model_form" model="ir.ui.view">
        <field name="name">platform.credentials.create.model.form</field>
        <field name="model">platform.credentials</field>
        <field name="inherit_id" ref="odoo_pim_connector.view_platform_credentials_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="platform_model_id" invisible="1"/>
                <button name="create_platform_model"
                        type="object" invisible="platform_model_id"
                        string="Create CT Table"
                        class="btn btn-danger"/>
            </xpath>
        </field>
    </record>
</odoo>