<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pim_product_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="d">
                <div class="page" style="font-family: Arial, sans-serif; color: #2f2f2f;">
                    <style>
                        * {
                        font-family: "DejaVu Sans", Arial, sans-serif;
                        }
                        @page {
                        margin: 50px 25px 50px 25px;
                        }

                        .page {
                        margin-top: 10px;
                        padding: 0;
                        color: #2f2f2f;
                        page-break-after: always; /* ensures new product starts on a new page */
                        }

                        .pim-group-title {
                        background: #f3f4f6;
                        padding: 8px 12px;
                        margin-top: 26px;
                        font-size: 14px;
                        font-weight: 600;
                        border-left: 4px solid #714B67;
                        page-break-inside: avoid; /* prevents group title and table from splitting across pages */
                        }
                        .pim-table {
                        page-break-inside: avoid; /* prevents tables from splitting across pages */
                        }


                        /* ================= HEADER ================= */
                        .pim-header {
                        background: #714B67;
                        color: #ffffff;
                        padding: 22px 20px;
                        text-align: center;
                        }

                        .pim-header h3 {
                        margin: 0;
                        font-weight: 700;
                        font-size: 22px;
                        color: #ffffff;
                        }

                        .pim-header small {
                        display: block;
                        margin-top: 8px;
                        font-size: 12px;
                        color: #f1f1f1;
                        }

                        .pim-header small span {
                        font-weight: 700;
                        color: #ffffff;
                        }

                        /* ================= BODY ================= */
                        .pim-body {
                        padding: 22px;

                        }

                        /* ================= TOP SECTION ================= */
                        .pim-top {
                        display: flex;
                        gap: 40px;
                        align-items: flex-start;
                        margin-bottom: 30px;
                        }

                        /* ================= PRIMARY IMAGE ================= */
                        .pim-primary {
                        width: 280px;
                        flex-shrink: 0;
                        background: #fafafa;
                        border: 1px solid #e1e1e1;
                        border-radius: 10px;
                        padding: 12px;
                        }

                        .pim-primary img {
                        width: 100%;
                        height: 260px;
                        object-fit: contain;
                        }

                        /* ================= RIGHT SIDE ================= */
                        .pim-right {
                        flex: 1;
                        display: flex;
                        flex-direction: column;
                        gap: 24px;
                        }

                        .pim-desc-title {
                        font-size: 15px;
                        font-weight: 600;
                        margin-bottom: 6px;
                        }

                        .pim-description {
                        font-size: 13px;
                        line-height: 1.7;
                        color: #555;mrgin-top: 22px;
                        background: #fafafa;
                        padding: 14px 16px;
                        border-radius: 8px;
                        border: 1px solid #e6e6e6;
                        }

                        /* ================= ADDITIONAL IMAGES ================= */
                        .pim-additional {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 20px;
                        margin-top: 14px;
                        padding-top: 14px;
                        border-top: 1px dashed #ddd;
                        }

                        .pim-additional img {
                        width: 82px;
                        height: 82px;
                        object-fit: contain;
                        border: 1px solid #ddd;
                        border-radius: 8px;
                        margin-left: 12px;
                        margin-bottom: 12px;
                        padding: 6px;
                        background: #ffffff;
                        }

                        /* ================= GROUP TITLES ================= */
                        .pim-group-title {
                        background: #f3f4f6;
                        padding: 8px 12px;
                        margin-top: 30px;
                        font-size: 14px;
                        font-weight: 600;
                        border-left: 4px solid #714B67;
                        }

                        /* ================= TABLE ================= */
                        .pim-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 8px;
                        font-size: 13px;
                        }

                        .pim-table td {
                        padding: 8px 10px;
                        border-bottom: 1px solid #e6e6e6;
                        }

                        .pim-table td:first-child {
                        width: 30%;
                        background: #fafafa;
                        font-weight: 600;
                        color: #555;
                        }
                    </style>

                    <t t-set="doc" t-value="d['product']"/>
                    <t t-set="images" t-value="d['images']"/>
                    <t t-set="title">
                        <t t-esc="doc.name"/>
                        -
                        <t t-esc="doc.default_code"/>
                    </t>


                    <!-- HEADER -->
                    <div class="pim-header">
                        <h3 t-esc="doc.name"/>
                        <small>
                            <span>SKU:</span>
                            <t t-esc="doc.default_code"/>
                            |
                            <span>Category:</span>
                            <t t-esc="', '.join(doc.pim_category_ids.mapped('name'))"/>
                            |
                            <span>Family:</span>
                            <t t-esc="doc.family_id.name"/>
                        </small>
                    </div>

                    <!-- BODY -->
                    <div class="pim-body">
                        <!-- TOP SECTION -->
                        <div class="pim-top">
                            <!-- PRIMARY IMAGE -->
                            <div class="pim-primary">
                                <img t-if="images['primary']"
                                     t-att-src="'data:image/png;base64,%s' % images['primary']"/>
                            </div>

                            <!-- DESCRIPTION + ADDITIONAL -->
                            <div class="pim-right" style="margin-left:10px;">
                                <div class="pim-desc-title">Description</div>
                                <div class="pim-description">
                                    <ul>
                                        <t t-foreach="clean_html(doc.description).split('\n')" t-as="line">
                                            <t t-if="line.strip()">
                                                <li t-esc="line.strip()"/>
                                            </t>
                                        </t>
                                    </ul>
                                </div>

                                <!-- ADDITIONAL IMAGES -->
                                <t t-if="images['additional']">
                                    <div class="pim-additional" style="margin-right: -30px;">
                                        <t t-foreach="images['additional']" t-as="img">
                                            <img t-att-src="'data:image/png;base64,%s' % img"/>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- DYNAMIC GROUPS -->


                        <t t-foreach="d['grouped_fields']" t-as="grp">
                            <h4 class="pim-group-title">
                                <t t-esc="grp['group']"/>
                            </h4>
                            <table class="pim-table">
                                <tbody>
                                    <t t-foreach="grp['attributes']" t-as="att">
                                        <tr>
                                            <td>
                                                <t t-esc="att['label']"/>
                                            </td>
                                            <td>
                                                <!-- SAME DISPLAY LOGIC AS WEBSITE -->
                                                <t t-set="value" t-value="att['value']"/>
                                                <t t-set="field_info" t-value="att['field_info']"/>

                                                <t t-if="field_info.get('display_type') == 'price'">
                                                    <strong>
                                                        <t t-esc="currency.symbol"/>
                                                        <t t-set="currency" t-value="doc.company_id.currency_id"/>
                                                        <span t-esc="value"
                                                              t-options="{'widget': 'float', 'precision': 2}"/>

                                                    </strong>
                                                </t>
                                                <t t-elif="field_info.get('display_type') == 'yes_no'">
                                                    <t t-if="value">Yes</t>
                                                    <t t-else="">No</t>
                                                </t>
                                                <t t-elif="field_info.get('display_type') in ('multi_select','multi','pills','ref_data_multi')">
                                                    <t t-foreach="value" t-as="v">
                                                        <span class="pim-pill">
                                                            <t t-esc="v"/>
                                                        </span>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="value"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_pim_product_pdf" model="ir.actions.report">
        <field name="name">Product PDF</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pim_website.pim_product_report</field>
        <field name="report_file">pim_website.pim_product_report</field>
        <field name="print_report_name">
            (object and object.name or 'Product')
        </field>

        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="product.paperformat_label_sheet"/>
    </record>
</odoo>