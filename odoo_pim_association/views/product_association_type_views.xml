<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_association_type_list_view" model="ir.ui.view">
        <field name="name">product.association.type.list</field>
        <field name="model">product.association.type</field>
        <field name="arch" type="xml">
            <list string="Association Types" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="product_association_type_form_view" model="ir.ui.view">
        <field name="name">product.association.type.form</field>
        <field name="model">product.association.type</field>
        <field name="arch" type="xml">
            <form string="Association Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_association_type_action" model="ir.actions.act_window">
        <field name="name">Association Types</field>
        <field name="res_model">product.association.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_association_type"
              name="Association Types"
              parent="pim_ext.menu_root_product_management"
              action="product_association_type_action"
              sequence="60"/>

</odoo>
