<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_association_form_view" model="ir.ui.view">
        <field name="name">product.template.association.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id"
               ref="pim_ext.view_product_creation_split_view_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='history_products']" position="before">
                <page string="Associations" name="associations_page">
                    <group>
                        <field name="id" widget="pim_association_manager" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>