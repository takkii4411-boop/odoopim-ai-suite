<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_attribute_master_inherit_channel" model="ir.ui.view">
        <field name="name">product.attribute.master.channelisation.layout</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="pim_ext.view_product_attribute_master_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='is_value_per_channel']" position="after">
                <field name="platform_credential_ids"
                       domain="[('is_active','=', True)]"
                       invisible="not is_value_per_channel"
                       placeholder="Select Channels"
                       widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>