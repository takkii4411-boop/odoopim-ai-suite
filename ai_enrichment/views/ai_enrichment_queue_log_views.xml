    <!-- Form View (FIXED) -->
    <record id="view_ai_enrichment_queue_log_form" model="ir.ui.view">
        <field name="name">ai.enrichment.queue.log.form</field>
        <field name="model">ai.enrichment.queue.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false" delete="true">
                <header>
                    <button name="action_refresh_status" type="object" string="Refresh Status" class="btn-primary"
                            invisible="state in ('done', 'failed')"/>
                    <!-- FIX: Restored the statusbar widget for a professional look -->
                    <field name="state" widget="statusbar" statusbar_visible="queued,processing,done,failed"/>
                </header>
                <sheet>
                    <!-- <h1><field name="name" readonly="1"/></h1> -->
                    <h1>
                        <field name="reference" readonly="1"/>
                    </h1>

                    <group>
                        <group string="Sync Configuration">
                            <field name="name"/>
                            <field name="config_id" invisible="1"/>
                            <field name="prompt_type"/>
                            <field name="update_field" invisible="1"/>
                            <field name="update_field_label" string="Updated Field"/>
                            <!--                            <field name="error_message"/>-->
                        </group>
                        <group string="Sync Details">
                            <field name="type"/>
                            <field name="create_date"/>
                            <field name="product_count"/>
                        </group>
                    </group>

                    <notebook>

                        <!--                                                <page string="Products" name="products">-->
                        <!--                                                    <field name="product_ids" readonly="1">-->
                        <!--                                                        <list>-->
                        <!--                                                            <field name="default_code"/>-->
                        <!--                                                            <field name="name"/>-->
                        <!--                                                        </list>-->
                        <!--                                                    </field>-->
                        <!--                                                </page>-->

                        <!--                                                <page string="Products" name="products">-->
                        <!--                                                    <field name="product_templates" readonly="1">-->
                        <!--                                                        <list>-->
                        <!--                                                            <field name="default_code"/>-->
                        <!--                                                            <field name="name"/>-->
                        <!--                                                        </list>-->
                        <!--                                                    </field>-->
                        <!--                                                </page>-->

                        <page string="Products" name="products">
                            <field name="product_templates" readonly="1">
                                <list editable="bottom">
                                    <field name="id"/>
                                    <field name="default_code"/>
                                    <field name="name"/>
<!--                                    <button name="action_redirect_to_product"-->
<!--                                            type="object"-->
<!--                                            string="Open Product"-->
<!--                                            class="btn-primary"-->
<!--                                            icon="fa-external-link"/>-->
                                    <button name="action_redirect_to_product"
                                            string="Go to Product"
                                            type="object"
                                            class="oe_highlight"
                                      icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>

                        <page string="Products Variants" name="products">
                            <field name="product_variants" readonly="1">
                                <list editable="bottom">
                                    <field name="id"/>
                                    <field name="default_code" optional="hide"/>
                                    <field name="display_name"/>
                                    <button name="action_redirect_to_product_variant"
                                            string="Go to Variant"
                                            type="object"
                                            class="oe_highlight"
                                      icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>


                        <page string="Results Summary" name="results">
                            <group>
                                <group>
                                    <field name="generation_success_count"/>
                                    <field name="generation_failed_count"/>
                                    <field name="error_message"/>
                                </group>
                                <group>
                                    <field name="update_success_count"/>
                                    <field name="update_failed_count"/>
                                </group>
                            </group>

                            <field name="error_message" invisible="state not in 'failed'" style="color:red;"/>
                            <field name="results_json" widget="ace" options="{'editor_mode': 'json'}" readonly="1"
                                   invisible="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_ai_enrichment_queue_log_search" model="ir.ui.view">
        <field name="name">ai.enrichment.queue.log.search</field>
        <field name="model">ai.enrichment.queue.log</field>
        <field name="arch" type="xml">
            <search string="AI Enrichment Logs">
                <field name="reference"/>
                <field name="name"/>
                <field name="create_date"/>
                <field name="type"/>
                <field name="state"/>

                <!-- Filter for Done -->
                <filter name="done" string="Done" domain="[('state','=','done')]"/>

                <!-- Filter for Failed -->
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>

                <!-- Filter for Product AI Enrichment -->
                <filter name="product_ai_enrichment" string="Product AI Enrichment"
                        domain="[('type','=','Product Ai Enrichment')]"/>

                <filter name="update_success" string="Updated Products"
                        domain="[('update_success_count','>=',1)]"/>


                <filter name="update_failed" string="Failed Products"
                        domain="[('update_failed_count','>=',1)]"/>


                <!--                            <filter name="is_ai_enrichable"-->
                <!--                    string="AI Enrichable"-->
                <!--                    domain="[('is_ai_enrichable','=',True)]"/>-->


                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_by_create_date" string="Created Date"
                            context="{'group_by':'create_date'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by':'state'}"/>

                </group>
            </search>
        </field>
    </record>


    <record id="view_product_attribute_search_ai" model="ir.ui.view">
        <field name="name">product.attribute.search.ai</field>
        <field name="model">product.attribute</field>
        <field name="arch" type="xml">
            <search string="Product Attributes">
                <field name="name"/>
                <filter name="is_ai_enrichable"
                        string="AI Enrichable"
                        domain="[('is_ai_enrichable','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_is_ai_enrichable"
                            string="AI Enrichable"
                            context="{'group_by':'is_ai_enrichable'}"/>
                </group>
            </search>
        </field>
    </record>


