<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pim_ai_translate.AttributeChannelLocalePopInherited"
       t-inherit="pim_locales_channels.AttributeChannelLocalePop"
       t-inherit-mode="extension">

        <!--
             1. UNGROUPED VIEW
             Target the input directly inside the platform body table
        -->
        <xpath expr="//div[contains(@t-attf-id, 'platform_body')]//input[@type='text']" position="after">
            <AiTranslateButton langId="row.langs[lang].x_lang_id" />
        </xpath>

        <!--
             2. GROUPED VIEW
             Target the input directly inside the field type table
        -->
        <xpath expr="//div[contains(@t-attf-id, 'field_type')]//input[@type='text']" position="after">
            <AiTranslateButton langId="row.langs[lang].x_lang_id" />
        </xpath>

    </t>

</templates>