<odoo>
    <template id="custom_footer_template" inherit_id="web.webclient_bootstrap">
    <xpath expr="//meta[@name='viewport']" position="after">
            <div class="custom-footer">
                <img src="/ai_bot/static/src/img/main_bot.png" class="footer-image" alt="Footer Image" id="botImage" loading="lazy"/>
                <div class="bot-chat" id="botChat">
                    <div class="chat-header">
                        <span>ODOO BOT</span>
                        <div class="icons-left">
                            <button id="clearChat">&#x21bb;</button>
                            <button id="closeChat">&#x00D7;</button>
                        </div>
                    </div>
                        <div class="chat-body custom-background">
                            <div class="bot-info card-style">
                                <img src="/ai_bot/static/src/img/bot.gif" class="bot-icon" alt="Bot Icon" loading="lazy"/>                            
                                <span class="bot-description">
                                    <strong>Your Odoo Guide</strong> is <em>ready to assist you!</em> Just ask me anything related to your Odoo environment.<br/>Whether you need help with <strong>sales</strong>,
                                    <strong>purchases</strong>, or <strong>inventory</strong>, I'm here to provide <em>instant support</em> and guidance.<br/>
                                    <strong>Let’s make your Odoo experience smoother</strong> and more efficient.</span>
                            </div>                            
                            <!-- Confirmation Popup (Initially Hidden) -->
                            <div id="confirmationPopup" class="confirmation-popup glass-effect" style="display: none;">
                                <p>Clearing the chat will delete the conversation memory as well. Are you sure?</p>
                                <button id="confirmDelete" class="btn confirm-btn">Yes</button>
                                <button id="cancelDelete" class="btn cancel-btn">No</button>
                            </div>
                        </div>
                    <div class="chat-footer">
                        <label class="toggle-switch">
                            <input type="checkbox" id="toggleScrape"/>
                            <span class="slider"></span>
                        </label>
                        <input type="text" placeholder="Type your message..." class="chat-input" id="userMessage"/>
                        <!-- <button class="newbutton send-button" id="sendButton">Send</button> -->
                         <div class="star-button send-button">
                            <span class="icon">✨</span>
                         </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
