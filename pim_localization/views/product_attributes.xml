<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_attribute_master_custom_inherit" model="ir.ui.view">
        <field name="name">product.attribute.translation.fields</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="pim_ext.view_product_attribute_master_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='History']" position="after">
                <page name="type_label_translation"
                      string="Label Translations"
                      invisible="not is_value_per_locale">
                    <field name="product_product_field_id" invisible="1"/>
                    <field name="product_template_field_id" invisible="1"/>
                    <field name="name" widget="t_widget" class="w-100"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_product_attribute_js_class_extra_localise" model="ir.ui.view">
        <field name="name">product.attribute.master.js</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="pim_ext.view_product_attribute_master_custom_js_class"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='History']" position="after">
                <page name="type_label_translation"
                      string="Label Translations"
                      invisible="not is_value_per_locale">
                    <field name="product_product_field_id" invisible="0"/>
                    <field name="product_template_field_id" invisible="0"/>
                    <field name="name" widget="t_widget" class="w-100"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>