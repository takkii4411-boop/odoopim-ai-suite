    <t t-name="control_panel.productListView" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="attributes">
            <attribute name="className">'prm-content'</attribute>
        </xpath>
        <xpath expr="//t[@t-component='props.Renderer']" position="attributes">
        <attribute name="showButtons">props.showButtons</attribute>
    </xpath>

        <xpath expr="//t[@t-foreach='archInfo.headerButtons']" position="after">
<!--            <t t-if="props.showButtons">-->
            <div class="o-checkbox list-check o_field_discontinued o_boolean_toggle form-switch">
                    <label class="list-check-label" for="toggle-discontinued"
                           style="display:flex; align-items:center; padding: 5px;">
                        <input
                                type="checkbox"
                                class="form-check-input hide_discontinued"
                                id="toggle-discontinued"
                                t-on-click="() => this.show_discontinued? this.hidearchived() : this.showarchived()"
                                t-att-checked="this.show_discontinued"
                        />
                        <span class="list-check-label" style="margin-left: 5px; font-weight: 700;">Discontinued</span>
                    </label>
                </div>
            <!--            </t>-->

        </xpath>
    </t>
