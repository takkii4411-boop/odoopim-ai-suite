<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.char.capitalize</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add inside the Performance block -->
            <xpath expr="//block[@name='performance']" position="inside">
                <setting id="char_capitalize_setting"
                         help="Automatically capitalize the first letter when typing in char fields">
                    <field name="enable_char_capitalize"/>
                    <div class="content-group" invisible="not enable_char_capitalize">
                        <div class="text-muted mt16">
                            The first letter of all char field inputs will be automatically capitalized.
                        </div>

                        <!-- Step 1: Select Models -->
                        <div class="row mt16">
                            <label for="excluded_models_capitalize" string="Select Models"
                                   class="col-lg-3 o_light_label"/>
                            <field name="excluded_models_capitalize"
                                   widget="many2many_tags"
                                   placeholder="Select models to configure..."
                                   options="{'no_create': True, 'no_open': True}"/>
                        </div>
                        <div class="text-muted mt8">
                            <i class="fa fa-info-circle"/> Select models first, then choose specific fields below (optional).
                        </div>

                        <!-- Step 2: Select Fields (Optional) -->
                        <div class="row mt16" invisible="not excluded_models_capitalize">
                            <label for="excluded_fields_capitalize" string="Excluded Fields (Optional)"
                                   class="col-lg-3 o_light_label"/>
                            <field name="excluded_fields_capitalize"
                                   widget="many2many_tags"
                                   placeholder="Select specific fields (optional)..."
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('ttype', '=', 'char'), ('model_id', 'in', excluded_models_capitalize)]"/>
                        </div>
                        <div class="text-muted mt8" invisible="not excluded_models_capitalize">
                            <i class="fa fa-lightbulb-o"/>
                            <strong>Behavior:</strong><br/>
                            • If you select specific fields → Only those fields will be excluded<br/>
                            • If you leave fields empty → ALL char fields in the selected models will be excluded
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
